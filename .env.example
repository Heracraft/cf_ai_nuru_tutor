# --- Database ---------------------------------------------------------------
# Local development against the compose Postgres.
DATABASE_URL="postgres://nuru:nuru@localhost:5432/nuru_tutor"

# --- AI provider -------------------------------------------------------------
# Set at least one key. OpenAI wins when both are present.
OPENAI_API_KEY="sk-..."
GOOGLE_GENERATIVE_AI_API_KEY=""

# Force a provider regardless of which keys exist: "openai" or "google".
# Leave blank to pick by key presence.
AI_PROVIDER=""

# Point the OpenAI client somewhere else: OpenRouter, Groq, a local vLLM.
# Leave blank for api.openai.com.
OPENAI_BASE_URL=""

# Model overrides. Blank uses the defaults below.
#   openai -> chat: gpt-5-mini, plan: gpt-5-mini, help: gpt-5-nano
#   google -> gemini-2.5-flash for all three
AI_MODEL_CHAT=""
AI_MODEL_PLAN=""
AI_MODEL_HELP=""

# --- Compose only -------------------------------------------------------------
# Consumed by docker-compose.yml, not by the app.
POSTGRES_USER="nuru"
POSTGRES_PASSWORD="nuru"
POSTGRES_DB="nuru_tutor"
APP_PORT="3000"
